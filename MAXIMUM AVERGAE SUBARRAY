#include <stdio.h>

double findMaxAverage(int* nums, int numsSize, int k) {

    long long currentSum = 0;
    for (int i = 0; i < k; i++) {
        currentSum += nums[i];
    }
    
    long long maxSum = currentSum;
    

    for (int i = k; i < numsSize; i++) {

        currentSum += nums[i] - nums[i - k];
        
        if (currentSum > maxSum) {
            maxSum = currentSum;
        }
    }
    

    return (double)maxSum / k;
}
