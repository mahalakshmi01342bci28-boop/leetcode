#include <stdio.h>
#include <string.h>
#include <stdlib.h>

int diff_by_one(char *w1, char *w2) {
    int diff = 0;
    int len = strlen(w1);
    for (int i = 0; i < len; i++) {
        if (w1[i] != w2[i]) {
            diff++;
            if (diff > 1) return 0;
        }
    }
    return diff == 1;
}

int ladderLength(char *beginWord, char *endWord, char **wordList, int wordListSize) {
    int queue[5005];
    int visited[5005] = {0};
    int dist[5005];
    int head = 0, tail = 0;

    int end_found = 0;
    for (int i = 0; i < wordListSize; i++) {
        if (strcmp(wordList[i], endWord) == 0) {
            end_found = 1;
            break;
        }
    }
    if (!end_found) return 0;

    for (int i = 0; i < wordListSize; i++) {
        if (diff_by_one(beginWord, wordList[i])) {
            queue[tail++] = i;
            visited[i] = 1;
            dist[i] = 2; 
        }
    }

    while (head < tail) {
        int curr_idx = queue[head++];
        char *curr_word = wordList[curr_idx];

        if (strcmp(curr_word, endWord) == 0) {
            return dist[curr_idx];
        }

        for (int i = 0; i < wordListSize; i++) {
            if (!visited[i] && diff_by_one(curr_word, wordList[i])) {
                visited[i] = 1;
                dist[i] = dist[curr_idx] + 1;
                queue[tail++] = i;
            }
        }
    }

    return 0;
}
