#include <stdlib.h>
#include <string.h>

int* decrypt(int* code, int codeSize, int k, int* returnSize) {
    *returnSize = codeSize;
    int* result = (int*)malloc(codeSize * sizeof(int));
    

    if (k == 0) {
        memset(result, 0, codeSize * sizeof(int));
        return result;
    }
    
 
    int start = 0, end = 0;
    if (k > 0) {
        start = 1;
        end = k;
    } else { // k < 0
        start = codeSize + k;    
        end = codeSize - 1;      
    }
    

    int currentSum = 0;
    for (int i = start; i <= end; i++) {
        currentSum += code[i];
    }
    

    for (int i = 0; i < codeSize; i++) {
        result[i] = currentSum;
        

        currentSum -= code[start % codeSize];

        currentSum += code[(end + 1) % codeSize];
        

        start++;
        end++;
    }
    
    return result;
}
