#include <stdio.h>
#include <stdlib.h>
#include <string.h>

int cmpfunc (const void * a, const void * b);

/**
 * Note: The returned array must be malloced, assume caller calls free().
 */

static char * names[] = {"Gold Medal", "Silver Medal", "Bronze Medal"};
//All other ranks will be an itoa() call

char ** findRelativeRanks(int* score, int scoreSize, int* returnSize){

    char **result = (char **)malloc(scoreSize * sizeof(char *));                         //step 0 initialize result
    if (result == NULL)
        exit(1);

    int *sortedScore = (int *)malloc(scoreSize * sizeof(int));
    if (sortedScore == NULL)
        exit(1);

    for (int i = 0; i < scoreSize; i++)                 //step 1: Copy array
        sortedScore[i] = score[i];

    qsort(sortedScore, scoreSize, sizeof(int), cmpfunc);    //step 2: sort the copy => sortedcopy

    for (int i = 0; i < scoreSize; i++)     //step 3:  (for every s in score) -> (binary search for s in sortedcopy.  Store index of s in sortedcopy in result)
    {
        int theFuckingNumber = score[i];
        int place = -1;

        int first = 0;
        int last = scoreSize - 1;

        while (first <= last) { //NESTED LOOPS LETS GO!!!
            int middle = first + (last -  first) / 2;

            if (sortedScore[middle] == theFuckingNumber) {
                place = middle;
                break;
            } else if (sortedScore[middle] < theFuckingNumber)
                last = middle - 1; //DONT SCREW WITH THE LOGIC HERE ITS REVERSE SORTED ORDER!!!!
            else
                first = middle + 1;
        }



        if (place < 0)
            exit(1);

        if (place < 3) {
            result[i] = strdup(names[place]);
        } else {
            result[i] = (char *)malloc(20);
            if (result[i] == NULL)
                exit(1);
            sprintf(result[i], "%d", place + 1);
        }
    }

    free(sortedScore);
    *returnSize = scoreSize;
    return result;
}


int cmpfunc (const void * a, const void * b) {  //this is right
    if (*(int*) a > *(int *) b)
        return -1;
    else if (*(int*) a < *(int *) b)
        return 1;
    else
        return 0;
}
